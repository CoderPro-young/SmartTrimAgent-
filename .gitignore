# Python
__pycache__/
*.py[cod]
.venv/

# 运行时产物
TMP/
OUTPUT/
output/

# 用户素材（Web 上传 / 手动放进 INPUT/），避免误提交大文件。
# 注意：仓库历史里的示例素材仍是已跟踪文件，gitignore 不影响它们，
# `git checkout -- INPUT/` 依然能正常取回。
INPUT/*
!INPUT/.gitkeep

# 内置曲库（Mixkit 免费授权禁止原始音频再分发，故不入库；
# 下载方式与曲目溯源见 MUSIC/README.md 与 MUSIC/meta.json）
MUSIC/*
!MUSIC/README.md
!MUSIC/meta.json

# 敏感配置（真实 API key，勿提交）
.env

# 编辑器本机配置（含本机解释器路径）
.vscode/

# 工作区会话数据（记忆 / 日志 / 本地脚本，勿提交）
.workbuddy/

# ZCode 会话数据（本地脚本 / 运行痕迹）
.zcode/

# V9.0 会话落盘（含 last_plan / expansions，本机私有）
web/.sessions/

# 测试数据集素材仓（同 INPUT/ 理由：大文件不入库；用例清单见 tests/test_dataset.md）
tests/dataset_materials/*
!tests/dataset_materials/.gitkeep

# 数据集重放产物（run-*.json 报告）
tests/results/

# 会话导出 / 备份（同 web/.sessions/ 理由，本机私有）
conversation_history/
web/.sessions.backup-*/

# 插件运行时痕迹
.video_agent/

# 效果验证用临时截图（_verify_* 目录）
_verify_*/
