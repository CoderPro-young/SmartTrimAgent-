# ---- Model backend (pick ONE provider) ----

# Option A: SiliconFlow (硅基流动) — OpenAI-compatible, free Qwen models
SILICONFLOW_API_KEY=sk-your-siliconflow-key
MODEL_NAME=deepseek-ai/DeepSeek-V4-Flash
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1   # default, usually unneeded

# Option B: OpenAI-compatible (OpenAI / DeepSeek / Qwen / local vLLM ...)
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# Option C: Anthropic-compatible (Claude / DashScope Qwen ...)
# ANTHROPIC_API_KEY=sk-your-key-here
# ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Option D: Explicit provider:model string (highest flexibility).
# Overrides the options above. LangChain `provider:model` convention.
# DEEPAGENT_MODEL=openai:gpt-4o-mini

# ---- 主模型请求超时 / 重试 / 流式（2026-10-28 链测定性后收紧） ----
# 默认流式（MODEL_STREAMING=1）：read timeout 按 chunk 间隔计——挂死请求在首
# token 前后 ~MODEL_TIMEOUT 秒即断，健康的慢生成不受整段预算约束，MODEL_TIMEOUT
# 才敢用 60。回滚设 MODEL_STREAMING=0（timeout 默认值自动回 180，语义变回
# 「整段生成时长」预算）。重试耗尽才抛给上层 plan_with_retry（自动重出计划）。
# 2026-10-28 15:01 实测：非流式 180s × (1+2 次 SDK 静默重试) = 541.6s 纯等待。
# MODEL_STREAMING=1
# MODEL_TIMEOUT=60
# MODEL_RETRIES=1
# VLM_TIMEOUT=60                             # VLM 打标同修（原 120×3=362s×4 并发放大）
# VLM_RETRIES=1
# MODEL_MAX_TOKENS=16384  # 输出预算 max_tokens；不设时 SiliconFlow 按模型上限
                          # 填充，prompt+预算超窗口会被 400（2026-10-26 事故）

# ---- V4 感知层：VLM 抽帧打标（可选；不配则自动降级为纯场景切分信号） ----
# 默认复用上面的 SiliconFlow key，零配置即可用；想换供应商再配下面三项。
# VLM_MODEL=zai-org/GLM-4.5V                  # 打标默认（2026-09-24 A/B 实测更准）
# VLM_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct    # 更快更省的备选
# VLM_API_KEY=                                # 独立供应商 key（配了它就不再复用 SiliconFlow）
# VLM_BASE_URL=                               # 独立供应商必须显式给 OpenAI 兼容端点
# VLM_FRAME_BUDGET=24                         # 每个素材最多抽多少帧送 VLM（成本上限）
# VLM_BATCH=6                                 # 每次请求带几帧
# VLM_MAX_TOKENS=8192                         # 打标输出预算（同 MODEL_MAX_TOKENS 的坑）
# VLM_THINKING=0                              # 打标关 thinking（perf V1，2026-11-01；
                                              # GLM-4.5V 默认 thinking 曾单笔烧 63k
                                              # tokens/961s；=1 开回对照）
# VLM_CONCURRENCY=2                           # 打标批并发（perf V3：原 4 路在预热+
                                              # 任务内同跑时撞 429，降为 2）

# ---- 感知层并发治理（perf V2/A2，2026-11-01） ----
# ANALYZE_PARALLELISM=2                       # analyze_media 重管线并发上限
                                              # （agent 并行调 6 路解码+推理曾互相
                                              # 争抢把 1s 拖到 104.7s）
# INFLIGHT_ANALYZE_TIMEOUT=1500               # 等在途分析的上限秒数（超时自算兜底）
# HEVC_HWACCEL=1                              # A3：HEVC 素材感知层解码走 d3d11va
                                              # （实测 2.5K HEVC10 analyze 218→94s；
                                              # H.264 不适用，按 codec 自动判定）

# ---- 全链路耗时埋点（perf trace，2026-11-01） ----
# 默认开启：每次任务（/api/run、/api/replan）与上传预热自动落盘
# TMP/perf/<时间>_<会话前8>_t<轮>_<origin>.json + 同名 .txt 摘要
# （各环节耗时、LLM TTFT、VLM 批次、ffmpeg 命令明细），
# 解读方法见 docs/perf-instrumentation.md。置 0 完全禁用。
# PERF_TRACE=1

# ---- LangSmith tracing (optional) ----
# 打开后每次 agent 运行会上报到 LangSmith 平台，可在网页看到完整调用链。
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxx
# LANGSMITH_PROJECT=DeepAgentDemo


# ---- 镜头切分（V7.10）：TransNetV2 主切分器（装了 torch 才生效）----
# TRANSNET_PRIMARY=0          # 回到 V7.9「过碎复核」旧形态（默认 1 = 模型先行）
# TRANSNET_RESCUE=0           # 整体不接模型，纯 ffmpeg 启发式（行为同 V7.8）
# TRANSNET_DEVICE=cpu         # 推理设备，默认 cpu
# TRANSNET_WEIGHTS=           # 自定义 .pth 权重路径（缺省用 pip 包自带权重）

# 使用方法：复制本文件为 .env（已 gitignore），填入真实值即可。
