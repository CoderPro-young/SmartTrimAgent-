<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="字幕生成流水线" id="caption-pipeline">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ 阶段背景带 ============ -->
        <mxCell id="lane1" value="① 感知与选材（上游）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#cccccc;fontStyle=1;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="10" width="1100" height="280" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="② 文案来源（提供器决策链）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdfaf3;strokeColor=#e0d5b8;fontStyle=1;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="1100" height="330" as="geometry" />
        </mxCell>
        <mxCell id="lane3" value="③ 编译与渲染（时间轴 → 字幕 overlay）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c5d5e3;fontStyle=1;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1100" height="560" as="geometry" />
        </mxCell>

        <!-- ============ ① 感知与选材 ============ -->
        <mxCell id="start" value="用户提交 smart_create&#xa;（一键成片）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="50" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="素材索引 analyze_media&#xa;TransNetV2 主切分 + VLM 打标（desc 画面描述）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="450" y="140" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="粗筛 + 选材 shot_select&#xa;画质 good/ok · 静音比 ≤0.8 · 最短 1.5s · 跨素材轮转装填" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="220" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- ============ ② 文案来源 ============ -->
        <mxCell id="d1" value="计划自带&#xa;captions？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="340" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p_plan" value="plan 提供器：文案直接采用&#xa;生成模块完全不参与&#xa;credits 时总时长 = 行数 × 秒/行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="830" y="345" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="subtitle_style&#xa;= credits？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="470" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="narr" value="旁白制 _write_narration（一次 LLM 写全片）&#xa;按组给字数预算 = 组时长 × 3~5 字/秒&#xa;第一人称 · 信息保真 · 禁套路词 · 附带标题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="110" y="460" width="310" height="90" as="geometry" />
        </mxCell>
        <mxCell id="split" value="确定性断句 _split_narration_units&#xa;标点切分 · &lt;5 字碎片并入前条 · &gt;18 字硬换行&#xa;→ _narration〔组 → 字幕单元〕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="110" y="585" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fb" value="一镜一句回退链&#xa;llm 逐镜写句 → labels 标签兜底（captions_source 标注来源）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="470" y="590" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- ============ ③ 编译与渲染 ============ -->
        <mxCell id="derive" value="compile_plan → _derive 时间轴&#xa;各镜起点 / 时长 / 总时长 D（转场重叠计入）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="450" y="700" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="disp" value="铺轴分发 _apply_captions（按暂存键）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="460" y="790" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="_apply_narration 字符加权铺轴&#xa;组窗口〔首镜起点 → 末镜终点〕&#xa;单元时长 ∝ 字数（末条吃余数）&#xa;⇒ 一镜可挂多句 · 一句可跨剪辑点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="110" y="880" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="逐片段绑定（句数 = 镜头数）&#xa;数量不齐 → 均分时间轴（旧路径）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="450" y="890" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="credits 整块滚动&#xa;y = h − (h+text_h)·(t−ts)/dur&#xa;text_align=C 逐行居中 + 描边" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="790" y="880" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="render" value="drawtext 渲染 _drawtext_chain（两路径共用）&#xa;底部字幕抬离底缘 12% 画高（避相机水印）· 统一 yuv420p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="1030" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="out" value="成片 + 摘要卡&#xa;标题 / captions_source 来源 / 兜底警示" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="470" y="1130" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- ============ 图例 ============ -->
        <mxCell id="legend" value="图例：紫色 = 有模型参与（LLM/VLM）&#xa;蓝色 = 确定性代码（可离线测试）&#xa;黄色 = 决策分支 · 绿色 = 起止" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="1130" width="290" height="70" as="geometry" />
        </mxCell>

        <!-- ============ 边 ============ -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="a1">
