        <mxCell id="e8" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="narr" target="split">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="失败（重试 1 次后）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="narr" target="fb">
          <mxGeometry relative="1" as="geometry">
