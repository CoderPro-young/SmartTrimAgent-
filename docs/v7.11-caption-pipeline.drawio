          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="否（bottom 默认）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d2" target="narr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="d2" target="fb">
          <mxGeometry relative="1" as="geometry" />
