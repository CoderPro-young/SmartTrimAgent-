        <mxCell id="p1" value="用户任务（自然语言）&#xa;上下文三优先级：问答接续 &gt; 修订 &gt; 首轮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sw1">
