        </mxCell>
        <mxCell id="p3" value="素材实况：INPUT/ 清单 + ffprobe 缓存探针&#xa;内容卡缓存（TMP/probe/，上传即索引）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sw1">
          <mxGeometry x="720" y="50" width="340" height="55" as="geometry" />
