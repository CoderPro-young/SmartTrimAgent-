        <mxCell id="sw1" value="① 输入与会话（web/server.py → plan_with_retry）" style="swimlane;startSize=32;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f8fbff;fontStyle=1;fontSize=13;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
