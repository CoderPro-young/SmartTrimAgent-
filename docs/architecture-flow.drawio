        <mxCell id="sw1" value="① 用户输入" style="swimlane;startSize=32;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f8fbff;fontStyle=1;fontSize=13;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
