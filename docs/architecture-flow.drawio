        <mxCell id="n1" value="自然语言需求&#xa;（一句话描述剪辑意图）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="sw1">
